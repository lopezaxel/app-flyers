# Copiá a .env.local y completá. Nunca subas .env.local.
SESSION_SECRET=            # 32+ caracteres aleatorios
APP_USER=                  # lo define `npm run set-login`
APP_PASSWORD_HASH_B64=     # lo define `npm run set-login`
DATABASE_URL=              # pooler de Supabase con el rol flyers_app
GEMINI_API_KEY=            # proyecto de Google Cloud dedicado
BLOB_READ_WRITE_TOKEN=     # Vercel Blob
